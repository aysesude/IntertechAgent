# env — .env.example ŞABLONDUR ve commit edilir, gerçek .env asla edilmez
.env
.env.local
.env.*.local
!.env.example

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# node / frontend
node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# db / vector store data
# Bunlar üretilen çıktılar, kaynak kod değil. Commit edilirlerse her ingest
# sonrası değişip merge çakışması üretirler ve repoyu şişirirler. Vektör
# veritabanı `python -m rag.ingest` ile dokümanlardan yeniden üretilir.
pgdata/
chroma_data/
chroma_db/
data/chroma_db/
*.db
*.sqlite3

# huggingface embedding modeli önbelleği
.cache/
models--*/

# ide
.vscode/
.idea/
.DS_Store

# commit mesaji taslaklari
# `git commit -F commit_msg.txt` akisindan kalan artiklar depoya sizmisti
# (31 Agustos 2026: uc dosya birden). Mesajin kendisi zaten git gecmisinde
# duruyor; kok dizindeki kopya yalnizca kafa karistirir.
commit_msg*.txt

# Ham ekran kayitlari (100 MB ustu, GitHub reddeder).
# Sikistirilmis surumleri docs/video/ altinda ve depoya dahil.
/video/

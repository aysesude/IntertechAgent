# Bu dosyayı .env olarak kopyalayıp değerleri düzenleyin: cp .env.example .env
# Gerçek .env asla commit edilmez (.gitignore'da).

# ---- Uygulama ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_USER=finans
POSTGRES_PASSWORD=finans
POSTGRES_DB=finans_danismani
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# backend içinden kullanılan tam bağlantı adresi (docker-compose servis adıyla)
DATABASE_URL=postgresql+psycopg://finans:finans@postgres:5432/finans_danismani

# ---- Veri katmanı ----
# Sentetik üretimin "bugün"ü — BOS BIRAKIN.
#
# Bos oldugunda seed, ankraji veritabanindaki en son GERCEK fiyat gunune
# baglar; defter fiyatlarin bittigi gun biter ve aradaki acik sifir olur.
# Sabit bir tarih yazarsaniz her seyi ezer ve o gunden sonraki her gun icin
# "son islem" ile "son fiyat" arasindaki acik bir gun daha buyur.
#
# Yalnizca yeniden uretilebilir bir kosu gerektiginde doldurun
# (ornek: ANCHOR_DATE=2026-08-01). Testler bunu conftest.py'de sabitliyor.
ANCHOR_DATE=
# TCMB EVDS tarihsel seriler için ücretsiz API anahtarı (evds2.tcmb.gov.tr >
# üyelik > API anahtarı). Boşsa tarihsel kur yfinance yedeğinden çekilir.
EVDS_API_KEY=

# ---- Chroma (vektör DB) ----
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=financial_documents

# ---- LLM sağlayıcı ----
# Seçenekler: openai | azure | ollama
LLM_PROVIDER=ollama

# openai kullanılırsa:
# Bu dosya git'e girer — ANAHTAR YAZMAYIN, boş bırakın. Gerçek değer yalnızca
# kendi .env dosyanızda ve sunucudaki .env'de durur (CI'da gitleaks taraması var).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# OpenAI uyumlu bir ağ geçidi kullanılıyorsa onun adresi. Sonunda /v1 olmalı.
# Resmi API için: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Bu SATIRI TAMAMEN SİLİK/YORUMLU bırakırsanız temperature isteğe hiç
# eklenmez — bazı modeller (ör. gpt-5.6-luna, ölçümle doğrulandı) HERHANGİ
# bir açık temperature değerini (0.0 dahil) 400 ile reddediyor, yalnızca
# örtük varsayılanı (1) kabul ediyor. UYARI: satırı BOŞ DEĞERLE bırakmak
# (`OPENAI_TEMPERATURE=`) uygulamayı başlatmada çökertir (pydantic-settings
# float parse hatası) — "boş bırakmak" satırın kendisinin silinmesi
# demektir. Modeliniz temperature destekliyorsa açıkça bir sayı yazın
# (ör. 0.0, deterministik niyet sınıflandırması için tercih edilir).
# OPENAI_TEMPERATURE=0.0

# azure kullanılırsa:
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ollama kullanılırsa: Ollama'nın host makinede `ollama serve` ile ayakta olması beklenir
# (docker-compose'a ayrı bir ollama servisi eklenmedi). Konteynerden host'a ulaşmak için
# host.docker.internal kullanılır. Model önceden çekilmiş olmalı: `ollama pull qwen2.5:3b`
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# ---- MCP Server ----
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8100
# api/agents container'ından mcp_server servisine ulaşmak için (docker ağı)
MCP_SERVER_URL=http://mcp_server:8100/mcp
# Tool zaman aşımları (saniye) — asılı kalan çağrıya karşı emniyet supabı,
# performans hedefi değil (bkz. docs/MCP-TOOLS.md §5).
MCP_TOOL_TIMEOUT_DEFAULT=10
# RAG ilk çağrıda embedding modelini ve Chroma indeksini yükler (10-20 sn).
MCP_TOOL_TIMEOUT_RAG=60

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
# 5173 = frontend/ (mevcut arayüz), 5174 = frontend-v2/ (VİRA arayüzü).
# İkisi yan yana koşuyor; ikisi de listede olmalı.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Kimlik dogrulama (FR-0) ----
# ZORUNLU, varsayilani yok: tanimli degilse uygulama hic baslamaz. Sessizce
# sabit bir anahtarla calisip herkesin token uretebilmesindense acikca
# patlamasi tercih edildi. Kendinize bir anahtar uretin:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=degistirin-kendi-anahtarinizi-uretin
JWT_ALGORITHM=HS256
# Bir demo gunu. Sure dolunca kullanici yeniden giris yapar (refresh yok).
JWT_EXPIRE_MINUTES=480

# GECIS BAYRAGI. true = tum uclar token ister (varsayilan ve dogru deger).
# false = token GONDERMEYEN istekler gecer, ama gonderilen token yine
# dogrulanir.
#
# Bu bayragin varlik sebebi kalmadi: tek gerekcesi token gondermeyen eski
# frontend/ idi, o arayuz kaldirildi. Silinmesi ayri bir is — once her
# ortamda degerin `true` oldugu dogrulanmali (bkz. docs/API.md).
AUTH_ENFORCE=true

# Sentetik demo kullanicilarinin ORTAK sifresi. Gizli degil: `make demo-users`
# ciktisinda kullanicilarin T.C. kimlik numaralariyla birlikte zaten basiliyor.
# Giris ekrani 6 haneli sayisal sifre bekliyor.
DEMO_USER_PASSWORD=460213

# ---- Sifre yenileme (DEMO) ----
# AKIS TEMSILIDIR: e-posta GONDERILMEZ, kod sunucuda uretilmez ve saklanmaz —
# asagidaki sabit kod kabul edilir. Sifre ise GERCEKTEN guncellenir.
#
# GUVENLIK SINIRI: bu uclar kimlik dogrulamasi ISTEMEZ. T.C. kimlik numarasini
# ve bu kodu bilen biri o hesabin sifresini degistirebilir — yani kimlik
# dogrulamasinin etrafindan dolasan bir kapidir. Sentetik demo verisiyle
# calisan, sureli bir gosterim icin kabul edildi.
# GERCEK BIR DAGITIMDA `false` yapin; yerine e-posta dogrulamasi, sunucuda
# uretilen tek kullanimlik kod, sure ve deneme sinirlari gerekir.
DEMO_PASSWORD_RESET_ENABLED=true
DEMO_RESET_CODE=123456
# Arayuzdeki geri sayimin suresi (saniye).
PASSWORD_RESET_CODE_TTL_SECONDS=180

# ---- Chat ----
# Orchestrator'a bağlam olarak geçilen son mesaj sayısı
CHAT_CONTEXT_MESSAGE_LIMIT=10

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000

# frontend-v2'nin API taban adresi. Iki arayuz AYRI alan adlarindan servis
# ediliyorsa bu SART: her arayuz kendi kokenine istek atmali. Ozellikle test
# alan adi basic_auth ile korunuyorsa, komsu alan adina yapilan capraz koken
# istekleri basic_auth bilgisi tasimadigi icin 401 alir.
# Tanimli degilse VITE_API_BASE_URL'e duser (tek arayuzlu yerel kurulum).
#   ornek: VITE_API_BASE_URL_V2=https://v2.test.34.159.243.0.nip.io
#
# Arayuz KENDI alan adindan servis edilirken bos BIRAKILMALI: bos oldugunda
# VITE_API_BASE_URL'e duser, yani API ayni kokenden cagrilir. Dolu birakip
# baska bir alan adi yazmak, tarayicinin capraz koken isteklerine basic_auth
# bilgisi eklememesi yuzunden her istegin 401 almasina yol acar.
VITE_API_BASE_URL_V2=

# Arayuzun host portu (test ve prod ayni makinede kosuyor, cakismamali):
#   5173 test · 5174 prod
#
# Eski arayuz kaldirildi ve 5173/5174 bosaldi. Sunucuda bu portu
# DEGISTIRMEK Caddy'yi de degistirmeyi gerektirir: Caddy konteyner adina
# degil HOST PORTUNA vekillik ediyor ve Caddyfile bu depoda degil.
FRONTEND_V2_PORT_HOST=5173

